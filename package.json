{
  "name": "car-color-survey",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9 <23"
  },
  "scripts": {
    "predev": "prisma generate && prisma db push",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "prestart": "prisma db push --skip-generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "cross-env ADMIN_PASSWORD=test-password SESSION_SECRET=test-session-secret-at-least-32-chars vitest run",
    "test:watch": "cross-env ADMIN_PASSWORD=test-password SESSION_SECRET=test-session-secret-at-least-32-chars vitest",
    "test:e2e": "playwright test",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.12.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.12.0",
    "sharp": "^0.35.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "postcss": "^8.5.10"
  }
}
